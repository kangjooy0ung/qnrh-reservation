# Supabase 프로젝트 설정 → Project Settings → API 에서 확인
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key-here

# 관리자 로그인 비밀번호 (관리자 페이지 /admin 접근 시 사용)
ADMIN_PASSWORD=change-me

# 세션 쿠키 서명용 임의의 긴 무작위 문자열 (예: openssl rand -hex 32)
# 관리자·선생님 세션 서명에 공통으로 사용됩니다.
ADMIN_SESSION_SECRET=change-me-too

# 담당 선생님 로그인 비밀번호 (승인 필요 시설의 예약을 승인/반려하는 /teacher 페이지 접근 시 사용)
TEACHER_PASSWORD=change-me-again
